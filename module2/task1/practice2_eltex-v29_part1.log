# 6. Для пользователя user3 смените shell на /usr/sbin/nologin (man usermod),
#    выполните вход под этим пользователем при помощи утилиты su, сначала 
#    без дополнительных параметров, затем с явным указанием shell /bin/bash 
#    в параметрах su. Выполните logout

root@eltex-practice2-v29:~# usermod -s /usr/sbin/nologin user3
root@eltex-practice2-v29:~# su user3
This account is currently not available.
root@eltex-practice2-v29:~# su -s /bin/bash user3
user3@eltex-practice2-v29:/root$
user3@eltex-practice2-v29:/root$ exit
exit
root@eltex-practice2-v29:~# 


# 7. Создайте новую группу и добавьте её для всех пользователей user* как 
