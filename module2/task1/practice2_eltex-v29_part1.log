# 8. Создайте каталог /opt/share и назначьте группу из предыдущего пункта 
#    его владельцем, установите на этот каталог бит SGID, права для группы 
#    rwx.

root@eltex-practice2-v29:~# mkdir /opt/share
root@eltex-practice2-v29:~# chown :testgroup /opt/share/
root@eltex-practice2-v29:~# chmod g+rwx,g+s /opt/share/

