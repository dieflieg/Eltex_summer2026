# 10. Создайте переменную DATE, в которую запишите текущую дату. Проверьте содержимое переменной.
eltex-v29@eltex-2026-summer:~$ DATE=$(date +%F)
eltex-v29@eltex-2026-summer:~$ echo $DATE
2026-07-07

# 11. Создайте переменную TIME, в которую запишите текущее время. Проверьте содержимое переменной.
eltex-v29@eltex-2026-summer:~$ TIME=$(date +%T)
eltex-v29@eltex-2026-summer:~$ echo $TIME
15:22:56

# 12. Создайте переменную DATE_TIME в которую поместите значения из переменных DATE и TIME, 
#     разделенных пробелом. Проверьте содержимое переменной.
eltex-v29@eltex-2026-summer:~$ DATE_TIME="$DATE $TIME"
eltex-v29@eltex-2026-summer:~$ echo $DATE_TIME
2026-07-07 15:22:56

