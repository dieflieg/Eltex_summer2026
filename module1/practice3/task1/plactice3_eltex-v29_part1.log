# 4. В другом терминальном окне выполните команду passwd и оставьте ее 
#    в состоянии запроса текущего пароля

root@eltex-practice2-v29:~# su user1
Warning: your password will expire in 3 days.
user1@eltex-practice2-v29:/root$ passwd
Changing password for user1.
Current password:


# 5. Перейдите в терминальное окно с top и выполните следующие действия:
#	* выведите все процессы, для которых реальным пользователем
#      	  является пользователь, которым вы вошли в сеанс;
#	* найдите процесс, запущенный командой passwd;
#	* отправьте этому процессу сигналы 15 (SIGTERM), 2 (SIGINT),
#         3 (SIGQUIT), 9(SIGKILL)

# после запуска top нажмем кнопку U для возможности поиска пользователя

top - 15:52:45 up 6 days, 42 min,  2 users,  load average: 0,00, 0,00, 0,00
Tasks: 114 total,   1 running, 113 sleeping,   0 stopped,   0 zombie
%Cpu(s):  0,0 us,  0,0 sy,  0,0 ni, 97,8 id,  2,2 wa,  0,0 hi,  0,0 si,  0,0 st
MiB Mem :   3915,9 total,   2578,2 free,    526,7 used,   1096,2 buff/cache
MiB Swap:   3185,0 total,   3185,0 free,      0,0 used.   3389,2 avail Mem

    PID USER     RUSER     PR  NI S  %CPU  %MEM     TIME+ COMMAND
  21090 root     user1     20   0 S   0,0   0,1   0:00.00 passwd

# поскольку top по умолчанию фильтрует процессы по эффективному пользователю,
# определяющему привилегии выполнения, для процесса passwd таковым является root.

user1@eltex-practice2-v29:/root$ kill -15 21090
user1@eltex-practice2-v29:/root$ ps aux | grep "21090"
root       21090  0.0  0.0   9176  3900 pts/1    S+   15:51   0:00 passwd

user1@eltex-practice2-v29:/root$ kill -2 21090
user1@eltex-practice2-v29:/root$ ps aux | grep "21090"
root       21090  0.0  0.0   9176  3900 pts/1    S+   15:51   0:00 passwd

user1@eltex-practice2-v29:/root$ kill -3 21090
user1@eltex-practice2-v29:/root$ ps aux | grep "21090"
root       21090  0.0  0.0   9176  3900 pts/1    S+   15:51   0:00 passwd

user1@eltex-practice2-v29:/root$ kill -9 21090
user1@eltex-practice2-v29:/root$ ps aux | grep "21090"

# в окне вызова passwd видим следующее:
user1@eltex-practice2-v29:/root$ passwd
Changing password for user1.
Current password: Killed

# Видим, что процесс не отреанировал на все более
# вежливые сигналы и был остановлен только после
# отправки сигнала, который обрабатывается ядром
# напрямую.

# 6. Выполните команду vim ~/file_task3.txt и нажмите Ctrl-Z

user1@eltex-practice2-v29:/root$ vim ~/file_task3.txt
# Ctrl-Z
[1]+  Stopped                 vim ~/file_task3.txt


# 7. Выполните команду sleep 600, нажмите Ctrl-Z и выполните команду jobs

user1@eltex-practice2-v29:/root$ sleep 600
# Ctrl-Z
[2]+  Stopped                 sleep 600
user1@eltex-practice2-v29:/root$ jobs
[1]-  Stopped                 vim ~/file_task3.txt
[2]+  Stopped                 sleep 600


# 8. Последнее задание (sleep 600) сделайте фоновым
user1@eltex-practice2-v29:/root$ bg %2
[2]+ sleep 600 &

# 9. Измените число NICE у задания (sleep 600), сделав его равным 10

user1@eltex-practice2-v29:/root$ jobs -l
[1]+ 21122 Stopped                 vim ~/file_task3.txt
[2]- 21124 Running                 sleep 600 &
user1@eltex-practice2-v29:/root$ renice 10 21124
21124 (process ID) old priority 0, new priority 10


