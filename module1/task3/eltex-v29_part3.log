1048686 -rw-r--r-- 2 eltex-v29 eltex-v29 50 Jul  7 15:44 D1/D2/file.txt

# 7. Переместите файл file.txt в каталог D1.
eltex-v29@eltex-2026-summer-15:59> mv D1/D2/file.txt D1 

# 8. Проверьте работу ранее созданных ссылок на файл file.txt. 
#    Какая ссылка оказалась рабочей и почему?
eltex-v29@eltex-2026-summer-16:03> cat D1/D2/D3/hard_link.txt
Тестовый текст для задания
eltex-v29@eltex-2026-summer-16:03> cat D1/D2/D3/sym_link.txt
cat: D1/D2/D3/sym_link.txt: No such file or directory
# жесткая ссылка оказалась рабочей, потому что она ссылается на inode файла, а не на его имя или путь. 

# 9. Удалите каталог D2 со всем содержимым.
eltex-v29@eltex-2026-summer-16:06> rm -rf D2 

# 10. Найдите все файлы в системе размером больше 20МБ. Убедитесь в том (du), что найденные файлы имеют нужный размер. 
#     Запишите в файл $USER_part3_gt20M.log список найденных файлов.
eltex-v29@eltex-2026-summer-16:18> find / -type f -size +20M 2>/dev/null > "$USER"_part3_gt20M.log
 
