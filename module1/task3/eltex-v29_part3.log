# 1. Перейдите в домашний каталог, создайте файл $USER_part3.log.  
eltex-v29@eltex-2026-summer-15:37> cd ~
eltex-v29@eltex-2026-summer-15:37> touch "$USER"_part3.log

# 2. Создайте иерархию вложенных каталогов D1/D2/D3.
eltex-v29@eltex-2026-summer-15:40> eltex-v29@eltex-2026-summer-15:40> mkdir -p D1/D2/D3 

# 3. В каталоге D2 создайте обычный пустой файл file.txt.
eltex-v29@eltex-2026-summer-15:43> eltex-v29@eltex-2026-summer-15:43> touch D1/D2/file.txt

# 4. Добавьте произвольный текст в файл file.txt.
eltex-v29@eltex-2026-summer-15:44> echo "Тестовый текст для задания" > D1/D2/file.txt 

# 5. В каталоге D3 создайте символическую и жесткие ссылки на file.txt.
eltex-v29@eltex-2026-summer-15:55> ln -s ../file.txt sym_link.txt
eltex-v29@eltex-2026-summer-15:56> ln  ../file.txt hard_link.txt

# 6. Докажите, что ссылки созданы успешно.
eltex-v29@eltex-2026-summer-15:56> ls -al
total 12
drwxr-xr-x 2 eltex-v29 eltex-v29 4096 Jul  7 15:56 .
drwxr-xr-x 3 eltex-v29 eltex-v29 4096 Jul  7 15:44 ..
